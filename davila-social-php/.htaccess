<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS si está disponible
    <IfModule mod_ssl.c>
        RewriteCond %{HTTPS} off
        RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    </IfModule>

    # Proteger archivos de datos y configuración
    <FilesMatch "\.(sqlite|db|env|json|lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes

# Configuración de compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
